<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.6">

        <model name="beacon">
                <static>true</static>
                <link name="beacon_link">
                        <inertial>
                                <ixx>0.16666</ixx>
                                <ixy>0</ixy>
                                <ixz>0</ixz>
                                <iyy>0.16666</iyy>
                                <iyz>0</iyz>
                                <izz>0.16666</izz>
                                <mass>1.0</mass>
                        </inertial>
                        <collision name="box_collision">
                                <geometry>
                                        <box>
                                             <size>1 1 1</size>
                                        </box>
                                </geometry>
                        </collision>

                        <visual name="box_visual">
                                <geometry>
                                        <box>
                                                <size>1 1 1</size>
                                        </box>
                                </geometry>
                                <material>
                                        <ambient>0 0 1 1</ambient>
                                        <diffuse>0 0 1 1</diffuse>
                                        <specular>0 0 1 1</specular>
                                </material>
                        </visual>

                </link>
                <pose>10 0 0 0 0 0</pose>
                <plugin
                filename="gz-sim-comms-endpoint-system"
                name="gz::sim::systems::CommsEndpoint">
                        <address>beacon_signal</address>
                        <topic>beacon_signal/rx</topic>
                        <broker>
                                <bind_service>/broker/bind</bind_service>
                                <unbind_service>/broker/unbind</unbind_service>
                        </broker>
                </plugin>
        
        </model>


</sdf>