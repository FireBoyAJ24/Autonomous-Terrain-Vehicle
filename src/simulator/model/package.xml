<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>model</name>
  <version>0.0.0</version>
  <description>Contains SDFformat files for the world, car and beacon</description>
  <maintainer email="Akshanjay2004@gmail.com">Akshanjay Kompelli</maintainer>
  <license>Apache 2.0</license>
  <author>Akshanjay Kompelli</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <depend>gazebo_ros</depend>


  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/models"/>
    <gazebo_ros gazebo_media_path="${prefix}/worlds"/>
  </export>
</package>